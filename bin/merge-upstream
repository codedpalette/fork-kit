#!/usr/bin/env bash
#
# Merge an upstream commit into the trunk (the current branch) and strip
# upstream's .github from the result. Prints one word: merged, current or
# conflict.
#
#   merge-upstream <upstream sha> <commit message>
#
# The trunk's .github belongs to the fork alone: after the merge, the whole
# directory is removed and the trunk's own .github/fork.yml and
# .github/workflows/fork-* are restored from the commit before the merge.
# Nothing is listed by name, so no file name can slip through. GitHub runs
# workflow files from the pushed commit and from the default branch, so
# upstream's workflows never run in the fork, and never see its secrets.
#
# A conflict only inside .github is resolved by that removal. Any other
# conflict aborts the merge and leaves the trunk as it was. So does an
# upstream change to FORK.md: upstream could otherwise add an exact copy of
# it, which merges cleanly, and change it in a later release.
#
# The same inputs always give the same tree, so the job that pushes can
# repeat the merge and compare it with the tree that was verified.

set -euo pipefail

[ $# -eq 2 ] || { echo "usage: ${0##*/} <upstream sha> <commit message>" >&2; exit 2; }
sha="$1" message="$2"

if git merge-base --is-ancestor "$sha" HEAD; then
    echo current
    exit 0
fi

abort() { git merge --abort; echo conflict; exit 0; }

if ! git merge -q --no-ff --no-commit "$sha" >/dev/null 2>&1; then
    while IFS= read -r -d '' path; do
        case "$path" in .github/*) ;; *) abort ;; esac
    done < <(git diff -z --name-only --diff-filter=U)
fi

git diff --cached --quiet HEAD -- FORK.md || abort

git rm -r -q --cached --ignore-unmatch -- .github
rm -rf -- .github
own=()
while IFS= read -r -d '' path; do
    case "$path" in .github/fork.yml | .github/workflows/fork-*) own+=("$path") ;; esac
done < <(git ls-tree -r -z --name-only HEAD -- .github)
if [ "${#own[@]}" -gt 0 ]; then
    git checkout -q HEAD -- "${own[@]}"
fi

git commit -q --no-verify -m "$message"
echo merged
