#!/usr/bin/env bash
#
# Render the fork templates into a fork's working tree.
#
#   render-templates <values.json> <fork dir>
#
# <values.json> holds every value, for example:
#
#   {"kit_repo": "me/fork-kit", "upstream": "org/project", "mirror": "main",
#    "trunk": "dev", "node": "22", "source": "release", "tag_prefix": "",
#    "verify": "npm ci && npm test", "suffix": "patched", "build": "npm run build",
#    "version_file": "package.json", "stamp": {"package.json": ".version = $version"},
#    "assets": ["dist/a.js"], "commit": [], "install": "Install with ..."}
#
# Writes .github/fork.yml, the three .github/workflows/fork-*.yml callers and
# FORK.md. In fork.yml every value is written as JSON, which is valid YAML, so
# no command or filter can break the file. Only {{name}} placeholders are
# replaced: GitHub's own ${{ ... }} expressions have spaces and stay as they
# are. For the tip source, lines that end in "# tip:remove" are dropped;
# otherwise only that marker goes. Checks the result with fork-config.
#
# Exit codes: 0 rendered, 1 bad values, 2 usage error.

set -euo pipefail

[ $# -eq 2 ] || { echo "usage: ${0##*/} <values.json> <fork dir>" >&2; exit 2; }
values="$1" out="$2"
bin="$(cd "$(dirname "$0")" && pwd)"
templates="$bin/../skills/fork/templates"

fail() { echo "error: $*" >&2; exit 1; }

jq -e 'type == "object"' "$values" >/dev/null 2>&1 || fail "$values is not a JSON object"
check() {
    jq -e --arg k "$1" --arg re "$2" '.[$k] | type == "string" and test($re)' "$values" >/dev/null ||
        fail "$1 must match $2"
}
check kit_repo '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$'
check upstream '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$'
check mirror '^[A-Za-z0-9_.][A-Za-z0-9_./-]*$'
check trunk '^[A-Za-z0-9_.][A-Za-z0-9_./-]*$'
check source '^(release|tag|tip)$'
check suffix '^[A-Za-z0-9]+$'

source="$(jq -r .source "$values")"

# render <template> <destination> <json|raw>
render() {
    jq -nr --rawfile t "$templates/$1" --slurpfile v "$values" --arg mode "$3" --arg source "$source" '
        $v[0] as $v
        | ($t | [scan("\\{\\{([a-z_]+)\\}\\}")[0]] | unique - ($v | keys)) as $missing
        | if ($missing | length) > 0 then error("missing values: \($missing | join(", "))") else . end
        | $t | rtrimstr("\n") | split("\n")
        | map(
            if test("#[[:space:]]*tip:remove$") then
              if $source == "tip" then empty else sub("[[:space:]]*# tip:remove$"; "") end
            else . end
            | . as $line
            | if $mode == "json" and ($line | test("^[[:space:]]*#") | not) then
                gsub("\\{\\{(?<k>[a-z_]+)\\}\\}"; $v[.k] | tojson)
              else
                gsub("\\{\\{(?<k>[a-z_]+)\\}\\}"; $v[.k] | if type == "string" then . else tojson end)
              end)
        | join("\n")' >"$out/$2"
}

mkdir -p "$out/.github/workflows"
render fork.yml .github/fork.yml json
render fork-sync.yml .github/workflows/fork-sync.yml raw
render fork-release.yml .github/workflows/fork-release.yml raw
render fork-check.yml .github/workflows/fork-check.yml raw
render FORK.md FORK.md raw

"$bin/fork-config" "$out/.github/fork.yml" >/dev/null
