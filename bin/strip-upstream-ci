#!/usr/bin/env bash
#
# Remove upstream's whole .github directory from the current commit, in a new
# commit on top. Used on sync/<ref> branches, which point at upstream's code:
# with .github gone, pushing the branch runs none of upstream's workflows in
# the fork. Nothing is listed by name, so no file name can slip through.
#
#   strip-upstream-ci <commit message>
#
# Makes no commit when there is no .github.

set -euo pipefail

[ $# -eq 1 ] || { echo "usage: ${0##*/} <commit message>" >&2; exit 2; }

git rm -r -q --ignore-unmatch -- .github
if git diff --cached --quiet HEAD; then
    exit 0
fi
git commit -q --no-verify -m "$1"
