#!/usr/bin/env bash
#
# Print the kit's next version from the commits since its last release.
#
#   kit-version <ref>     e.g. kit-version HEAD
#
# The last release is the highest vX.Y.Z tag that <ref> contains. The commits
# after it decide the bump, by their Conventional Commits prefix:
#
#   major  a "!" before the colon (feat!:, fix(sync)!:) or a
#          "BREAKING CHANGE:" line in the body
#   minor  feat:
#   patch  anything else
#
# Merge commits are skipped: their messages are GitHub's, not the author's.
# Prints nothing when there is no commit after the last release. Exits 1 when
# <ref> contains no vX.Y.Z tag: the first one is created by hand.

set -euo pipefail

[ $# -eq 1 ] || { echo "usage: ${0##*/} <ref>" >&2; exit 2; }
ref="$1"

last="$(git tag -l --merged "$ref" 'v*' | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -n 1 || true)"
if [ -z "$last" ]; then
    echo "${0##*/}: $ref contains no vX.Y.Z tag. Tag the first release by hand." >&2
    exit 1
fi

log="$(git log --no-merges --format='%s%n%b%x00' "$last..$ref")"
[ -n "$log" ] || exit 0

IFS=. read -r major minor patch <<<"${last#v}"
if grep -Eq '^[a-z]+(\([^)]*\))?!:|^BREAKING[ -]CHANGE:' <<<"$log"; then
    echo "v$((major + 1)).0.0"
elif grep -Eq '^feat(\([^)]*\))?:' <<<"$log"; then
    echo "v$major.$((minor + 1)).0"
else
    echo "v$major.$minor.$((patch + 1))"
fi
