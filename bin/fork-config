#!/usr/bin/env bash
#
# Read a fork.yml and print its values as name=value lines, ready to append to
# $GITHUB_OUTPUT. Lists and maps are printed as compact JSON. Missing optional
# keys get their defaults, and invalid files fail with a message.
#
#   fork-config <path to fork.yml>

set -euo pipefail

SCHEMA=1

[ $# -eq 1 ] || { echo "usage: ${0##*/} <fork.yml>" >&2; exit 2; }
file="$1"
[ -f "$file" ] || { echo "error: $file not found" >&2; exit 1; }

# A value with a newline could add extra name=value lines to $GITHUB_OUTPUT.
get() {
    local value
    value="$(yq -r "$1 // \"$2\"" "$file")"
    if [[ "$value" == *$'\n'* ]]; then
        echo "error: $file: ${1#.} must be a single line" >&2
        exit 1
    fi
    printf '%s' "$value"
}
json() { yq -o=json -I=0 "$1 // $2" "$file"; }
fail() { echo "error: $file: $*" >&2; exit 1; }

schema="$(get .schema '')"
[ "$schema" = "$SCHEMA" ] ||
    fail "schema $schema, but this kit reads schema $SCHEMA. Run the fork skill's upgrade mode."

for key in upstream mirror trunk; do
    [ -n "$(get ".$key" '')" ] || fail "required key $key is missing"
done

source="$(get .sync.source '')"
case "$source" in
    release | tag | tip) ;;
    *) fail "sync.source must be release, tag or tip, not '$source'" ;;
esac

tag_prefix="$(get '.sync["tag-prefix"]' '')"
[[ "$tag_prefix" =~ ^[A-Za-z0-9._@/-]*$ ]] ||
    fail "sync.tag-prefix may hold only letters, digits and . _ @ / -, not '$tag_prefix'"

# Assigned one by one: a failing get then stops the script (set -e).
kit="$(get .kit v1)"
kit_repo="$(get '.["kit-repo"]' '')"
upstream="$(get .upstream '')"
mirror="$(get .mirror '')"
trunk="$(get .trunk '')"
node="$(get .node lts/*)"
verify="$(get .sync.verify true)"
suffix="$(get .release.suffix patched)"
build="$(get .release.build true)"
version_file="$(get '.release["version-file"]' package.json)"

cat <<OUT
kit=$kit
kit-repo=$kit_repo
upstream=$upstream
mirror=$mirror
trunk=$trunk
node=$node
source=$source
tag-prefix=$tag_prefix
verify=$verify
suffix=$suffix
build=$build
version-file=$version_file
stamp=$(json .release.stamp '{}')
assets=$(json .release.assets '[]')
commit=$(json .release.commit '[]')
OUT
