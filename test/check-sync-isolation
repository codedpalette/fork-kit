#!/usr/bin/env bash
#
# Check the security layout of sync.yml: SYNC_TOKEN must never be reachable by
# upstream's code. The header comment of sync.yml explains why.
#
#   check-sync-isolation <path to sync.yml>
#
# Exits 1 and names every broken invariant.

set -euo pipefail

file="$1"
status=0
fail() { echo "broken: $*"; status=1; }

# Run scripts of a job with heredoc bodies removed: their text is printed, not run.
scripts() {  # <job>
    yq -r ".jobs.$1.steps[].run // \"\"" "$file" |
        awk '
            skip && $0 ~ "^[[:space:]]*" end "$" { skip = 0; next }
            skip { next }
            match($0, /<<-?[[:space:]]*'"'"'?[A-Za-z_]+'"'"'?/) {
                end = substr($0, RSTART, RLENGTH); gsub(/[^A-Za-z_]|^-/, "", end); sub(/^-/, "", end)
                skip = 1
            }
            { print }'
}

# 1. Only the push job may name SYNC_TOKEN.
for job in $(yq -r '.jobs | keys | .[]' "$file"); do
    [ "$job" = push ] && continue
    if yq ".jobs.$job" "$file" | grep -q SYNC_TOKEN; then
        fail "job '$job' references SYNC_TOKEN. Only the push job may hold it."
    fi
done

# 2. The merge job runs upstream code, so it gets no credentials at all.
checkouts="$(yq -r '.jobs.merge.steps[] | select(.uses // "" | test("^actions/checkout@")) | .with["persist-credentials"] | tostring' "$file")"
while read -r value; do
    [ "$value" = false ] || fail "a checkout in the merge job lacks persist-credentials: false."
done <<<"$checkouts"
if yq -r '.jobs.merge.permissions // {} | to_entries[] | .value' "$file" | grep -Eqv '^(read|none)$'; then
    fail "the merge job has write permissions. It may only read."
fi

# 3. The push job holds the token, so it runs no code but git, gh and the kit.
others="$(yq -r '.jobs.push.steps[] | select(has("uses")) | .uses' "$file" | grep -v '^actions/checkout@' || true)"
[ -z "$others" ] || fail "the push job uses actions other than checkout: $others"

push_scripts="$(scripts push)"
if grep -En '(^|[^A-Za-z_-])(npm|npx|yarn|pnpm|bun|node|make|pip3?|python3?)([^A-Za-z_-]|$)' <<<"$push_scripts"; then
    fail "the push job runs a package manager or interpreter."
fi
if grep -En '(^|[;&|(])\s*(eval|source|\.)\s|(^|[^A-Za-z_-])(ba|z|da)?sh\s.*-[A-Za-z]*c([^A-Za-z]|$)' <<<"$push_scripts"; then
    fail "the push job evaluates code."
fi
if grep -En '(^\s*|[;&|]\s*|\$\(\s*)"?\$\{?(VERIFY|BUILD)\b' <<<"$push_scripts"; then
    fail "the push job runs the fork's verify or build command."
fi

exit "$status"
